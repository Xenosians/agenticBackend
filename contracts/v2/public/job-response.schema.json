{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-itsm:contracts:v2:public:job-response",
  "title": "Durable Job Response",
  "description": "Canonical public representation of a Phoenix-owned durable AI job.",
  "type": "object",
  "required": [
    "job_id",
    "user_id",
    "conversation_id",
    "chat_id",
    "message",
    "status",
    "attempts",
    "created_at",
    "claimed_at",
    "lease_expires_at",
    "completed_at",
    "selected_agent",
    "proposed_tool",
    "result",
    "error",
    "contract_version"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "conversation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "chat_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "waiting_approval",
        "completed",
        "failed",
        "denied",
        "outcome_unknown"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "claimed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lease_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "selected_agent": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "proposed_tool": {
      "type": [
        "object",
        "null"
      ],
      "description": "When non-null, the object must also satisfy the canonical tool-proposal contract."
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "contract_version": {
      "const": 2
    },
    "workflow_contract": {
      "type": [
        "object",
        "null"
      ],
      "description": "Explicit user-reviewed requested operations. Restricts completeness; never grants tool permission or approval.",
      "required": [
        "version",
        "steps"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "capability",
              "grounded_arguments",
              "after_success_of"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
              },
              "capability": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,150}$"
              },
              "grounded_arguments": {
                "type": "object",
                "maxProperties": 32,
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,149}$"
                },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                }
              },
              "after_success_of": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "workflow_contract_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Phoenix-computed SHA-256 of the canonical requested workflow projection."
    }
  },
  "additionalProperties": false
}
