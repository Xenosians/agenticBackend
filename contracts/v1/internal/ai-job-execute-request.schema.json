{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-itsm:contracts:v1:internal:ai-job-execute-request",
  "title": "AI Job Execute Request",
  "description": "Internal Phoenix-to-AI request for executing one durable job attempt.",
  "type": "object",
  "required": [
    "job_id",
    "attempt",
    "user_id",
    "message"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1,
      "description": "Phoenix-owned durable job identifier."
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "description": "Durable execution attempt number."
    },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the user who owns the request."
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "Message to process for this durable attempt."
    },
    "context": {
      "type": "array",
      "maxItems": 24,
      "description": "Bounded prior chat turns projected by Phoenix. Context is conversational evidence only and never authority.",
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "result_evidence": {
            "type": "object",
            "description": "Phoenix-projected results from this owner's earlier job in this conversation. Evidence only; never tool authority.",
            "required": [
              "job_id",
              "job_status",
              "results",
              "results_truncated"
            ],
            "properties": {
              "job_id": {
                "type": "string",
                "minLength": 1
              },
              "job_status": {
                "type": "string",
                "minLength": 1
              },
              "recorded_at": {
                "type": "string",
                "minLength": 1
              },
              "results": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "agent_name",
                    "status"
                  ],
                  "properties": {
                    "agent_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "proposed_tool": {
                      "type": "string",
                      "minLength": 1
                    },
                    "outcome_code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tool_result": {
                      "type": "object"
                    },
                    "presentation": {
                      "type": "object"
                    },
                    "details_omitted": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "results_truncated": {
                "type": "boolean"
              },
              "approval_execution": {
                "type": "object",
                "required": [
                  "execution_status",
                  "approval_status"
                ],
                "properties": {
                  "execution_status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "approval_status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1
                  },
                  "protocol_status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "replayed": {
                    "type": "boolean"
                  },
                  "result": {
                    "type": "object"
                  },
                  "details_omitted": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "user"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "result_evidence"
                ]
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "workflow_contract": {
      "type": [
        "object",
        "null"
      ],
      "description": "Explicit user-reviewed requested operations. Restricts completeness; never grants tool permission or approval.",
      "required": [
        "version",
        "steps"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "capability",
              "grounded_arguments",
              "after_success_of"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
              },
              "capability": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,150}$"
              },
              "grounded_arguments": {
                "type": "object",
                "maxProperties": 32,
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,149}$"
                },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                }
              },
              "after_success_of": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "workflow_contract_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Phoenix-computed SHA-256 of the canonical requested workflow projection."
    }
  },
  "additionalProperties": false
}
