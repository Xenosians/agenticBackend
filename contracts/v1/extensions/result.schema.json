{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-itsm:contracts:v1:extensions:result",
  "title": "Extension Result",
  "description": "Validated output from an isolated extension invocation. A valid result is not an authorization or provider receipt.",
  "type": "object",
  "required": ["schema", "contract_version", "extension_id", "extension_version", "result"],
  "properties": {
    "schema": {"const": "extension-result.v1"},
    "contract_version": {"const": 1},
    "extension_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "extension_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "result": {
      "type": "object",
      "required": ["schema", "rows", "input_rows", "output_rows", "elapsed_ms", "isolation"],
      "properties": {
        "schema": {"const": "lua-row-transform.v1"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"type": "object"}
        },
        "input_rows": {"type": "integer", "minimum": 1, "maximum": 10000},
        "output_rows": {"type": "integer", "minimum": 1, "maximum": 10000},
        "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 20000},
        "isolation": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 48}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
