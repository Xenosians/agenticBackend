{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-itsm:contracts:v1:public:job-create-response",
  "title": "Create Job Response",
  "description": "Acknowledges a newly created job or the current state of the same durable submission after recovery.",
  "type": "object",
  "required": [
    "job_id",
    "status"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1,
      "description": "Phoenix-owned durable job identifier."
    },
    "status": {
      "enum": [
        "pending",
        "processing",
        "waiting_approval",
        "completed",
        "failed",
        "denied",
        "outcome_unknown"
      ],
      "description": "New jobs begin pending. A recovered submission reports its existing state without resetting execution."
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workflow_contract": {
      "type": [
        "object",
        "null"
      ],
      "description": "Explicit user-reviewed requested operations. Restricts completeness; never grants tool permission or approval.",
      "required": [
        "version",
        "steps"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "capability",
              "grounded_arguments",
              "after_success_of"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
              },
              "capability": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,150}$"
              },
              "grounded_arguments": {
                "type": "object",
                "maxProperties": 32,
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,149}$"
                },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                }
              },
              "after_success_of": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "workflow_contract_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "description": "Phoenix-computed SHA-256 of the canonical requested workflow projection."
    }
  },
  "anyOf": [
    {
      "required": [
        "submission_id"
      ]
    },
    {
      "properties": {
        "status": {
          "const": "pending"
        }
      }
    }
  ],
  "additionalProperties": false
}
