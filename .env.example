# ------------------------------------------------------------
# SurrealDB application configuration
#
# Copy this file to .env and provide local/deployment values.
# Do not commit .env.
#
# These values are consumed by Phoenix at runtime.
# Username/password are also consumed by Docker Compose.
# ------------------------------------------------------------

SURREALDB_URL=
SURREALDB_NAMESPACE=
SURREALDB_DATABASE=
SURREALDB_USERNAME=
SURREALDB_PASSWORD=

# ------------------------------------------------------------
# SurrealDB container configuration
# ------------------------------------------------------------

SURREALDB_IMAGE=
SURREALDB_CONTAINER_NAME=
SURREALDB_LOG_LEVEL=
SURREALDB_HOST_PORT=
SURREALDB_DATA_DIR=
SURREALDB_RESTART_POLICY=