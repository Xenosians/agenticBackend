# ------------------------------------------------------------
# Phoenix production deployment
# ------------------------------------------------------------

PHX_SERVER=
PORT=
PHX_PUBLIC_URL=
PHX_BIND_IP=
SECRET_KEY_BASE=

# ------------------------------------------------------------
# AI service
# ------------------------------------------------------------

AI_SERVICE_URL=
AI_RUN_TIMEOUT_MS=
AI_EXECUTE_TIMEOUT_MS=
AI_HEALTH_TIMEOUT_MS=
AI_READY_TIMEOUT_MS=

# ------------------------------------------------------------
# Durable queue worker
# ------------------------------------------------------------

QUEUE_WORKER_ENABLED=
QUEUE_WORKER_POLL_INTERVAL_MS=
QUEUE_WORKER_LEASE_SECONDS=

# ------------------------------------------------------------
# Internal service authentication
# ------------------------------------------------------------

ITSM_INTERNAL_JOB_TOKEN=

# ------------------------------------------------------------
# Browser frontend
#
# Comma-separated HTTP(S) origins.
# ------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080

# ------------------------------------------------------------
# Optional DNS clustering
# ------------------------------------------------------------

DNS_CLUSTER_QUERY=

# ------------------------------------------------------------
# SurrealDB application configuration
# ------------------------------------------------------------

SURREALDB_URL=
SURREALDB_NAMESPACE=
SURREALDB_DATABASE=
SURREALDB_USERNAME=
SURREALDB_PASSWORD=

# ------------------------------------------------------------
# SurrealDB container configuration
# ------------------------------------------------------------

SURREALDB_IMAGE=
SURREALDB_CONTAINER_NAME=
SURREALDB_LOG_LEVEL=
SURREALDB_HOST_PORT=
SURREALDB_DATA_DIR=
SURREALDB_RESTART_POLICY=

# ------------------------------------------------------------
# Encrypted temporary credential vault
#
# CREDENTIAL_ENCRYPTION_KEY_B64 must decode to exactly 32 random bytes.
# Generate a deployment key once and keep it outside SurrealDB.
# ------------------------------------------------------------

CREDENTIAL_ENCRYPTION_KEY_B64=
CREDENTIAL_KEY_VERSION=v1
CREDENTIAL_TTL_SECONDS=86400

# ------------------------------------------------------------
# Application users, sessions, chats, and mail
# ------------------------------------------------------------
AUTH_REGISTRATION_ENABLED=true
AUTH_SESSION_TTL_SECONDS=604800
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_COOKIE_NAME=itsm_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_ADMIN_EMAILS=
APP_FRONTEND_URL=http://127.0.0.1:8080
MAIL_FROM_EMAIL=no-reply@itsm.local
MAIL_FROM_NAME=Agentic ITSM
AI_JOB_CONTEXT_ENABLED=false
AI_JOB_CONTEXT_MAX_TURNS=12

# Outbound mail transport (local mailbox or real SMTP)
MAILER_MODE=local
# Gmail / Google Workspace example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

